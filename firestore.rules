rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "yiorgosantoni@gmail.com"; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid);
      allow update: if owns(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus','availableBalanceCents','totpSecret','admin']);
      allow delete: if isAdmin();
    }
    match /listings/{id} {
      allow read: if resource.data.status == 'active' || (signedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /conversations/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
      match /messages/{messageId} { allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants; allow write: if false; }
    }
    match /withdrawals/{id} { allow read: if signedIn() && (resource.data.sellerId == request.auth.uid || isAdmin()); allow write: if false; }
    match /kyc/{id} { allow read, write: if isAdmin(); }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
