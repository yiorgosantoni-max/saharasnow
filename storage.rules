rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function image(){ return request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)'); }
    function video(){ return request.resource.size < 200 * 1024 * 1024 && request.resource.contentType.matches('video/.*'); }
    match /profiles/{uid}/{file} { allow read: if true; allow write: if signedIn() && request.auth.uid == uid && image(); }
    match /listings/{uid}/{listingId}/{file} { allow read: if true; allow write: if signedIn() && request.auth.uid == uid && (image() || video()); }
    match /kyc/{uid}/{file} { allow read: if signedIn() && request.auth.uid == uid; allow write: if signedIn() && request.auth.uid == uid && image(); }
    match /messages/{conversationId}/{uid}/{file} { allow read: if true; allow write: if signedIn() && request.auth.uid == uid && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024; }
    match /messages/{conversationId}/{uid}/{file} { allow read: if true; allow write: if signedIn() && request.auth.uid == uid && request.resource.size > 0 && request.resource.size <= 100 * 1024 * 1024; }
    match /deliveries/{orderId}/{file} { allow read, write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
